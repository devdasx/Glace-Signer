      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opens a warning before treating every network state as offline."
          }
        }
      }
    },
    "signer.debug.network_override.disable.label" : {
      "comment" : "VoiceOver label for the red toolbar icon while the DEBUG-only network-isolation override is active.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restore Network Check"
          }
        }
      }
    },
    "signer.debug.network_override.disable.hint" : {
      "comment" : "VoiceOver hint explaining that disabling the DEBUG-only override immediately restores the real network state.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uses the device’s real network state immediately."
          }
        }
      }
    },
    "signer.debug.network_override.alert.title" : {
      "comment" : "Warning title before enabling the DEBUG-only network-isolation override.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ignore Network Isolation?"
          }
        }
      }
    },
    "signer.debug.network_override.alert.body" : {
      "comment" : "Hard warning that the DEBUG-only override makes every real network state appear offline to setup.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This debugging override treats Wi‑Fi and every other active network path as offline. Never enter or create a real wallet while it is enabled."
          }
        }
      }
    },
    "signer.debug.network_override.alert.enable" : {
      "comment" : "Destructive text-only confirmation that enables the DEBUG-only network-isolation override.",
