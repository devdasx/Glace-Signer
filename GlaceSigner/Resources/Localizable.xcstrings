      "comment" : "Rounded title while the signer checks for an active network path.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checking Connections"
          }
        }
      }
    },
    "signer.offline.checking.body" : {
      "comment" : "Explains that secret entry remains blocked while network state is being checked.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Secret entry stays locked until this device has no active network path."
          }
        }
      }
    },
    "signer.offline.status.checking" : {
      "comment" : "VoiceOver label for the network isolation progress indicator.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Checking network isolation."
          }
        }
      }
    },
    "signer.offline.ready.title" : {
      "comment" : "Rounded title briefly shown when no active network path is detected.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offline Path Confirmed"
          }
        }
      }
    },
    "signer.offline.ready.body" : {
      "comment" : "Confirms only that the app detects no active network path before automatic continuation.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No active network path is detected. Continuing securely."
          }
        }
      }
    },
    "signer.offline.wifi.title" : {
      "comment" : "Hard-warning title shown when an active Wi-Fi path is detected.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn Off Wi‑Fi"
          }
        }
      }
    },
    "signer.offline.wifi.body" : {
      "comment" : "Hard-warning explanation blocking signer secret entry while Wi-Fi is connected.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "An active Wi‑Fi connection was detected. Glace Signer will not handle wallet secrets until it disappears."
          }
        }
      }
    },
    "signer.offline.other.title" : {
      "comment" : "Hard-warning title shown when a non-Wi-Fi network path remains active.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disconnect This Device"
          }
        }
      }
    },
    "signer.offline.other.body" : {
      "comment" : "Hard-warning explanation blocking signer secret entry while another network path is active.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A network connection is still active. Disconnect every available connection before continuing."
          }
        }
      }
    },
    "signer.offline.instruction.airplane_mode" : {
      "comment" : "First isolation instruction on the hard-warning screen.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Turn on Airplane Mode."
          }
        }
      }
    },
    "signer.offline.instruction.wifi" : {
      "comment" : "Second isolation instruction on the hard-warning screen.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. Confirm Wi‑Fi stays off."
          }
        }
      }
    },
    "signer.offline.instruction.bluetooth" : {
      "comment" : "Third isolation instruction on the hard-warning screen.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. Turn off Bluetooth and unplug network adapters."
          }
        }
      }
    },
    "signer.offline.monitoring.note" : {
      "comment" : "Clarifies the limits of iOS network monitoring and that checking continues throughout setup.",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glace keeps checking for active network paths throughout setup. iOS cannot prove that every radio is physically disabled, so verify Airplane Mode and the Control Center yourself."
          }
        }
      }
    },
    "signer.debug.network_override.enable.label" : {
      "comment" : "VoiceOver label for the DEBUG-only toolbar icon before the network-isolation override is enabled.",
      "extractionState" : "manual",
      "localizations" : {
